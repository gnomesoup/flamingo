<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flamingo: Manage Transforms" 
        Height="450" 
        Width="650"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Left Panel - Preset List -->
        <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="8" Margin="0,0,10,0">
            <Label Content="Transform Presets:" FontWeight="Bold"/>
            <ListBox x:Name="preset_listbox" 
                     Height="300" 
                     SelectionChanged="on_preset_selected"/>
            
            <StackPanel Margin="0,10,0,0">
                <Button x:Name="btn_add" 
                        Content="Add New" 
                        Margin="0,0,0,5" 
                        Click="on_add_preset"/>
                <Button x:Name="btn_remove" 
                        Content="Remove" 
                        Click="on_remove_preset"/>
            </StackPanel>
        </StackPanel>
        
        <!-- Right Panel - Edit Fields -->
        <Label Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2"
               Content="Preset Name:"
               FontWeight="Bold"
               VerticalAlignment="Top"
               Margin="0,0,0,5"/>
        <TextBox x:Name="txt_name" 
                 Grid.Column="1" 
                 Grid.Row="0"
                 Grid.ColumnSpan="2"
                 VerticalAlignment="Center"
                 Margin="0,25,0,0"
                 Height="25"
                 IsEnabled="False"/>
        
        <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
               Content="Origin (X, Y, Z):" 
               Margin="0,5,0,0"/>
        <TextBox x:Name="txt_origin" 
                 Grid.Column="1" 
                 Grid.Row="1" 
                 VerticalAlignment="Center"
                 Height="25"
                 Margin="0,25,5,5"
                 IsEnabled="False"/>
        <Button x:Name="btn_pick_origin"
                Grid.Column="2"
                Grid.Row="1"
                Content="Pick"
                Width="50"
                Height="25"
                Margin="0,25,0,5"
                Click="on_pick_origin"
                IsEnabled="False"/>
        
        <Label Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
               Content="Target (X, Y, Z):" 
               Margin="0,5,0,0"/>
        <TextBox x:Name="txt_target" 
                 Grid.Column="1" 
                 Grid.Row="2" 
                 VerticalAlignment="Center"
                 Height="25"
                 Margin="0,25,5,5"
                 IsEnabled="False"/>
        <Button x:Name="btn_pick_target"
                Grid.Column="2"
                Grid.Row="2"
                Content="Pick"
                Width="50"
                Height="25"
                Margin="0,25,0,5"
                Click="on_pick_target"
                IsEnabled="False"/>
        
        <Label Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
               Content="Angle (degrees):" 
               Margin="0,5,0,0"/>
        <TextBox x:Name="txt_angle" 
                 Grid.Column="1" 
                 Grid.Row="3"
                 Grid.ColumnSpan="2"
                 VerticalAlignment="Center"
                 Height="25"
                 Margin="0,25,0,5"
                 IsEnabled="False"/>
        
        <Label Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2"
               Content="Scale:" 
               Margin="0,5,0,0"/>
        <TextBox x:Name="txt_scale" 
                 Grid.Column="1" 
                 Grid.Row="4"
                 Grid.ColumnSpan="2"
                 VerticalAlignment="Center"
                 Height="25"
                 Margin="0,25,0,5"
                 IsEnabled="False"/>
        
        <Button x:Name="btn_map_points" 
                Grid.Column="1" 
                Grid.Row="5"
                Grid.ColumnSpan="2"
                Content="Map Points" 
                Margin="0,10,0,5"
                Height="30"
                Click="on_map_points"
                IsEnabled="False"/>
        
        <Button x:Name="btn_save" 
                Grid.Column="1" 
                Grid.Row="6"
                Grid.ColumnSpan="2"
                Content="Save Preset" 
                Margin="0,10,0,5"
                Height="30"
                Click="on_save_preset"
                IsEnabled="False"/>
        
        <Button x:Name="btn_save_all" 
                Grid.Column="1" 
                Grid.Row="7"
                Grid.ColumnSpan="2"
                Content="Done" 
                Margin="0,5,0,0"
                Height="30"
                Click="on_save_all"/>
    </Grid>
</Window>